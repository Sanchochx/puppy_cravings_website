---
import { Image } from 'astro:assets';
import misionTitle from '@/assets/mision.png';
import visionTitle from '@/assets/vision.png';
import pawImage from '@/assets/huella.png';
import dogImage from '@/assets/perro.png';
import pawsBand from '@/assets/patas_amarillas_tile.png';
import Container from '@/components/layout/Container.astro';

// Borde de nube: semicírculos de distinto ancho y alto sobre un viewBox de 1440 x 80.
const bumps = [
  [150, 44], [110, 30], [140, 40], [120, 26], [130, 46], [100, 28],
  [130, 38], [130, 30], [110, 42], [120, 28], [120, 40], [80, 32],
];
let x = 0;
const arcs = bumps
  .map(([w, h]) => {
    x += w;
    return `a${w / 2} ${h} 0 0 1 ${w} 0`;
  })
  .join(' ');
const cloudPath = `M0 80 V50 ${arcs} V80 Z`;
// Mismo perfil de nubes como máscara de la banda (arriba y, invertido, abajo): sus ondas coinciden con las del borde lila.
const toMask = (inner: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 80' preserveAspectRatio='none'>${inner}</svg>`,
  )}")`;
const cloudMaskTop = toMask(`<path d='${cloudPath}'/>`);
const cloudMaskBottom = toMask(`<path d='${cloudPath}' transform='translate(0 80) scale(1 -1)'/>`);

const pawTilts = [96, 84, 98, 82, 96, 86];
---

<!-- Marca que hay JS antes de pintar la sección: sin JS los elementos de aparición quedan visibles -->
<script is:inline>
  document.documentElement.classList.add('js');
</script>

<section class="relative w-full [--h:2rem] md:[--h:3.5rem] lg:[--h:5rem] bg-brand-lavender text-primary mt-16 lg:mt-24 pt-16 pb-28 pr-8 md:pt-20 md:pb-44 md:pr-11 lg:pr-[10%] lg:pt-28 lg:pb-36">
  <!-- Borde ondulado (crema a lila): sale por encima de la sección, sobre el fondo crema -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-full">
    <svg
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      class="block w-full h-8 md:h-14 lg:h-20 text-brand-lavender fill-current"
    >
      <path d={cloudPath}></path>
    </svg>
  </div>

  <!-- Borde inferior: el mismo perfil de nubes, invertido, por debajo de la sección -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-full">
    <svg
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      class="block w-full h-8 md:h-14 lg:h-20 text-brand-lavender fill-current -scale-y-100"
    >
      <path d={cloudPath}></path>
    </svg>
  </div>

  <!-- Banda fija de huellas amarillas sobre morado: del borde superior al inferior de la sección, terminando en nubes con el mismo perfil -->
  <!-- Contenedor a todo el ancho de la sección (sin padding): 100cqw de la máscara = ancho exacto de las nubes lila -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 [container-type:inline-size]">
    <div
      aria-hidden="true"
      style={`background-image: url(${pawsBand.src}); --cloud-top: ${cloudMaskTop}; --cloud-bottom: ${cloudMaskBottom};
        -webkit-mask-image: var(--cloud-top), var(--cloud-bottom), linear-gradient(#000, #000); mask-image: var(--cloud-top), var(--cloud-bottom), linear-gradient(#000, #000);
        -webkit-mask-size: 100cqw var(--h), 100cqw var(--h), 100% calc(100% - 2 * var(--h) + 2px); mask-size: 100cqw var(--h), 100cqw var(--h), 100% calc(100% - 2 * var(--h) + 2px);
        -webkit-mask-position: right top, right bottom, left calc(var(--h) - 1px); mask-position: right top, right bottom, left calc(var(--h) - 1px);
        -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;`}
      class="pointer-events-none absolute right-0 top-[calc(var(--h)*-1)] bottom-[calc(var(--h)*-1)] w-8 md:w-11 lg:w-[10%] bg-repeat-y bg-size-[100%_auto]"
    >
    </div>
  </div>

  <!-- Huella (huella.png) asomando por la esquina inferior izquierda -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <Image
      src={pawImage}
      alt=""
      widths={[160, 240, 360]}
      sizes="(min-width: 1024px) 144px, (min-width: 768px) 112px, 80px"
      data-reveal="paw"
      class="absolute left-4 lg:left-10 bottom-0 w-20 md:w-28 lg:w-36 h-auto"
    />
  </div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-16 md:gap-y-20">
      <!-- Misión: izquierda -->
      <div class="lg:col-span-7">
        <h2>
          <Image
            src={misionTitle}
            alt="Misión"
            widths={[320, 480, 640, 800]}
            sizes="(min-width: 1024px) 384px, (min-width: 768px) 288px, 224px"
            data-reveal="left"
            class="h-auto w-56 md:w-72 lg:w-96"
          />
        </h2>
        <p data-reveal="text" style="--reveal-delay: 120ms" class="mt-6 md:mt-8 max-w-[62ch] text-base min-[400px]:text-lg md:text-xl lg:text-2xl leading-relaxed font-body text-primary">
          Transformar la nutrición de las mascotas elevando los estándares de producción y
          curaduría, pasando de lo básico a lo excepcional. Nos dedicamos a crear snacks
          <mark class="highlight px-1.5 py-0.5 rounded font-bold text-primary box-decoration-clone">100% orgánicos</mark> mediante
          un proceso profundo y consciente que apoya directamente al
          <mark style="--mark-extra: 300ms" class="highlight px-1.5 py-0.5 rounded font-bold text-primary">sector campesino</mark>,
          garantizando una calidad superior que honra la confianza de nuestros clientes y el
          bienestar integral de sus compañeros de vida.
        </p>
      </div>

      <blockquote data-reveal="quote" class="relative lg:col-span-5 self-center pl-6">
        <span aria-hidden="true" data-quote-bar class="absolute inset-y-0 left-0 w-1 bg-brand-yellow"></span>
        <p data-quote-text class="font-display text-2xl min-[360px]:text-3xl min-[400px]:text-4xl lg:text-5xl leading-tight text-balance text-primary">
          “De lo básico a lo excepcional.”
        </p>
      </blockquote>

      <!-- Recorrido de huellas hacia la Visión -->
      <div
        data-paw-trail
        aria-hidden="true"
        class="group lg:col-span-12 flex items-start justify-center lg:justify-start lg:pl-[22%] gap-4 md:gap-8 lg:gap-12"
      >
        {
          pawTilts.map((tilt, i) => (
            <svg
              viewBox="0 0 64 64"
              style={`--tilt: ${tilt}deg; transition-delay: ${i * 160}ms;`}
              class:list={[
                'w-8 md:w-12 lg:w-14 text-primary fill-current rotate-(--tilt)',
                i % 2 === 1 ? 'translate-y-5 md:translate-y-7' : '',
                'motion-safe:opacity-0 motion-safe:scale-50 motion-safe:transition-[opacity,scale] motion-safe:duration-300',
                'motion-safe:group-data-[visible=true]:opacity-100 motion-safe:group-data-[visible=true]:scale-100',
              ]}
            >
              <ellipse cx="13" cy="29" rx="5.5" ry="8" transform="rotate(-20 13 29)" />
              <ellipse cx="25" cy="16" rx="6" ry="9" transform="rotate(-8 25 16)" />
              <ellipse cx="40" cy="16" rx="6" ry="9" transform="rotate(8 40 16)" />
              <ellipse cx="52" cy="29" rx="5.5" ry="8" transform="rotate(20 52 29)" />
              <path d="M32 30c-10 0-18 10-18 18 0 7 6 9 11 8 4-1 5-2 7-2s3 1 7 2c5 1 11-1 11-8 0-8-8-18-18-18z" />
            </svg>
          ))
        }
      </div>

      <!-- Visión: derecha -->
      <div class="lg:col-span-7 lg:col-start-6">
        <h2>
          <Image
            src={visionTitle}
            alt="Visión"
            widths={[320, 480, 640, 800]}
            sizes="(min-width: 1024px) 384px, (min-width: 768px) 288px, 224px"
            data-reveal="right"
            class="block ml-auto lg:ml-0 h-auto w-56 md:w-72 lg:w-96"
          />
        </h2>
        <p data-reveal="text" style="--reveal-delay: 120ms" class="mt-6 md:mt-8 max-w-[62ch] text-base min-[400px]:text-lg md:text-xl lg:text-2xl leading-relaxed font-body text-primary">
          Consolidarnos como la marca líder en snacks orgánicos para mascotas, centrada en
          fomentar el bienestar animal con el crecimiento de una comunidad activa y
          transparente. Aspiramos a ser referentes por nuestra cercanía constante con el
          cliente y nuestra participación activa en ferias, convocatorias y redes sociales,
          todo esto respaldado por una identidad gráfica que refleje la calidad y la esencia
          natural de nuestra propuesta.
        </p>
      </div>
    </div>
  </Container>
</section>

<!-- Espacio bajo la sección, sobre el fondo global: deja sitio al borde inferior en nube y muestra al perro -->
<div class="flex justify-center px-6 pt-28 pb-16 md:pt-36 lg:pt-44 lg:pb-24">
  <!-- Capa externa: entrada al scroll. Capa interna (img): meneo al hover/tap. Separadas para que sus transform no choquen. -->
  <div data-reveal="dog" class="max-w-full">
    <Image
      src={dogImage}
      alt="Perro lila dentro de una bolsa amarilla de snacks, moviendo la cola"
      widths={[480, 720, 960]}
      sizes="(min-width: 1024px) 448px, (min-width: 768px) 384px, 256px"
      class="dog-wiggle h-auto w-64 md:w-96 lg:w-[28rem] max-w-full"
    />
  </div>
</div>

<script>
  // Un solo observer: marca el recorrido como visible al entrar y lo reinicia al salir del todo de pantalla,
  // así la animación se repite en cada entrada (scroll hacia abajo o hacia arriba) sin parpadeos.
  const trail = document.querySelector<HTMLElement>('[data-paw-trail]');
  if (trail) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        trail.dataset.visible = String(entry.isIntersecting);
      }
    });
    observer.observe(trail);
  }

  // Aparición al scroll: umbral 0.2 y una sola vez por elemento (se deja de observar al revelarlo).
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        revealObserver.unobserve(entry.target);
      }
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));
</script>
