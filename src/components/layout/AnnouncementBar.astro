---
import Badge from '@/components/ui/Badge.astro';
import { siteConfig } from '@/data/site';
---

<div
  class="bg-primary text-on-primary py-2 px-6 text-center text-[13px] flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5"
>
  <span>✨ Envíos a todo el país • Panadería canina 100% natural colombiana para colitas felices 🐾</span>
  <Badge variant="accent" class="px-2.5 py-0.5 text-xs tracking-wider">REGISTRO ICA APROBADO</Badge>
  <a
    href={siteConfig.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden lg:inline-flex items-center gap-1 text-brand-yellow font-bold hover:underline"
  >
    Escríbenos al {siteConfig.phone} →
  </a>
</div>
